<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="bai1"
    targetNamespace="http://tempuri.org/bai1.xsd"
    elementFormDefault="qualified"
    xmlns="http://tempuri.org/bai1.xsd"
    xmlns:mstns="http://tempuri.org/bai1.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>
	<xs:complexType name="TV">
		<xs:sequence>
			<xs:element name="NhaXB" maxOccurs="10">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Sach" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="TenSach" type="xs:string"></xs:element>
									<xs:element name="TheLoai" type="xs:string"></xs:element>
									<xs:element name="SoTrang">
										<xs:simpleType>
											<xs:restriction base="xs:int">
												<xs:maxExclusive value="400"></xs:maxExclusive>
												<xs:minExclusive value="50"></xs:minExclusive>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="MaSach">
									<xs:simpleType>
										<xs:restriction base="xs:ID">
											<xs:maxLength value="6"></xs:maxLength>
										</xs:restriction>
									</xs:simpleType>
								</xs:attribute>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="TenNXB">
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:enumeration value="Giao duc"></xs:enumeration>
								<xs:enumeration value="Tuoi Tre"></xs:enumeration>
								<xs:enumeration value="Khoa hoc ki thuat"></xs:enumeration>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="TenTV" type="xs:string"></xs:attribute>
	</xs:complexType>
</xs:schema>
